// JAB Dismissal — student pickup / dismissal service.
// Database `dismissal` on Cloud SQL instance elite-db (its own DB, isolated from jabops).
// Every operational table carries tenantId: tenants are rows, never forks.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenant + devices
// ---------------------------------------------------------------------------

model Tenant {
  id        String  @id @default(cuid())
  slug      String  @unique // "dekalb-arts"
  name      String
  // jab-ops Account.id — logical reference only, no cross-database FK.
  accountId String?
  timezone  String  @default("America/New_York")

  // Program day. "HH:MM" 24h local.
  programStart String @default("15:00")
  programEnd   String @default("18:00")

  // Late pickup policy: minutes past programEnd before "late", fee per block.
  lateThresholdMinutes Int @default(10)
  lateFeeCents         Int @default(100) // per block
  lateFeeBlockMinutes  Int @default(1)

  // Brand + vocabulary + copy overrides. The tenantConfig blob.
  settings Json?

  status String @default("active") // active | paused

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  devices       Device[]
  staff         StaffUser[]
  households    Household[]
  students      Student[]
  classGroups   ClassGroup[]
  restrictions  PickupRestriction[]
  attendance    AttendanceRecord[]
  requests      PickupRequest[]
  approvals     PickupApproval[]
  announcements Announcement[]
  outbox        MessageOutbox[]
  auditLogs     AuditLog[]
}

model Device {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  label      String // "Front door iPad"
  kind       String    @default("KIOSK") // KIOSK | STAFF
  location   String?
  tokenHash  String    @unique // sha256 of the device token in the URL
  status     String    @default("active") // active | revoked
  lastSeenAt DateTime?
  appVersion String?
  createdAt  DateTime  @default(now())

  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// People
// ---------------------------------------------------------------------------

// Staff and teachers are one model: a teacher is a staff user with role TEACHER.
model StaffUser {
  id       String  @id @default(cuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  name     String
  email    String?
  phone    String? // E.164 — where teacher pickup alerts go
  role     String  @default("STAFF") // ADMIN | SUPERVISOR | TEACHER | STAFF
  active   Boolean @default(true)
  photoUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classGroups ClassGroup[]

  @@unique([tenantId, email])
  @@index([tenantId, role])
}

model Household {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  name     String // "Johnson family"

  // Family pickup code. Stored retrievably ON PURPOSE: admins reprint PIN
  // letters, and a family code is a lookup key, not a release credential —
  // release always requires a staff actor. Rotate on compromise; revisit
  // hashing in the security phase.
  pin String

  balanceCents     Int     @default(0)
  balanceNote      String?
  preferredChannel String  @default("SMS") // SMS | EMAIL | BOTH
  notes            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guardians    Guardian[]
  students     Student[]
  authorized   AuthorizedAdult[]
  requests     PickupRequest[]
  restrictions PickupRestriction[]

  @@unique([tenantId, pin])
  @@index([tenantId])
}

model Guardian {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  firstName    String
  lastName     String
  phone        String? // E.164
  email        String?
  relationship String  @default("Parent")
  isPrimary    Boolean @default(false)
  canPickup    Boolean @default(true)
  notify       Boolean @default(true)
  photoUrl     String?

  // Opaque token for the no-login parent page /p/[token].
  parentToken String @unique @default(cuid())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  approvedAdults AuthorizedAdult[] @relation("verifiedBy")

  @@index([householdId])
  @@index([phone])
}

model AuthorizedAdult {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  name         String
  phone        String?
  relationship String?
  photoUrl     String?

  // null expiresAt = permanent. A "today only" approval gets end-of-day.
  status    String    @default("ACTIVE") // ACTIVE | PENDING_PARENT_VERIFY | DENIED | EXPIRED | REVOKED
  expiresAt DateTime?

  verifiedByGuardianId String?
  verifiedBy           Guardian? @relation("verifiedBy", fields: [verifiedByGuardianId], references: [id])
  verifiedAt           DateTime?
  createdVia           String    @default("ADMIN") // ADMIN | KIOSK_REQUEST | PARENT_LINK

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([householdId, status])
}

model Student {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  householdId String
  household   Household @relation(fields: [householdId], references: [id])

  firstName String
  lastName  String
  grade     String // K | 1..8
  photoUrl  String?

  // Staff-only. Never rendered on any public/kiosk surface.
  medicalNote String?

  dismissalDefault String  @default("CARLINE") // CARLINE | WALKUP | BUS
  active           Boolean @default(true)

  classGroupId String?
  classGroup   ClassGroup? @relation(fields: [classGroupId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendance   AttendanceRecord[]
  requestItems PickupRequestStudent[]
  restrictions PickupRestriction[]

  @@index([tenantId, grade, active])
  @@index([householdId])
}

model PickupRestriction {
  id          String     @id @default(cuid())
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  householdId String?
  household   Household? @relation(fields: [householdId], references: [id])
  studentId   String?
  student     Student?   @relation(fields: [studentId], references: [id])

  restrictedName String
  severity       String  @default("DO_NOT_RELEASE") // DO_NOT_RELEASE | FRONT_OFFICE_ONLY
  active         Boolean @default(true)

  effectiveFrom DateTime?
  effectiveTo   DateTime?

  // Floor staff see only "restriction on file". These fields are ADMIN-role reads.
  sourceNote      String?
  staffOnlyDetail String?
  reviewedBy      String?
  reviewedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, active])
  @@index([studentId])
}

// ---------------------------------------------------------------------------
// Program structure
// ---------------------------------------------------------------------------

model ClassGroup {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  grade String // K | 1..8
  name  String // "Grade 3"
  room  String?

  teacherId String?
  teacher   StaffUser? @relation(fields: [teacherId], references: [id])

  startTime String? // "15:00"
  endTime   String? // "18:00"
  season    String?
  year      Int?
  active    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students Student[]

  @@index([tenantId, grade])
}

// ---------------------------------------------------------------------------
// Operations
// ---------------------------------------------------------------------------

// One row per student per program day. The roll-call register.
model AttendanceRecord {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  studentId String
  student   Student @relation(fields: [studentId], references: [id])
  date      String // "YYYY-MM-DD" in tenant timezone — avoids UTC-shift bugs (see pg OID 1114 memory)

  // NOT_MARKED is the absence of a row. A row is CHECKED_IN | ABSENT | RELEASED | RELEASED_LATE
  status String @default("CHECKED_IN")

  checkInAt     DateTime?
  checkInById   String? // StaffUser.id
  checkInByName String?

  checkOutAt      DateTime?
  releasedToName  String?
  releasedToKind  String? // GUARDIAN | AUTHORIZED | OVERRIDE
  releasedById    String? // StaffUser.id — the human who performed the release
  releasedByName  String?
  releaseRequest  String? // PickupRequest.id
  reversed        Boolean   @default(false)
  reversedAt      DateTime?
  reversedReason  String?

  lateMinutes  Int @default(0)
  lateFeeCents Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, date])
  @@index([tenantId, date, status])
}

model PickupRequest {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  householdId String
  household   Household @relation(fields: [householdId], references: [id])

  requesterName       String
  requesterGuardianId String?
  requesterKind       String  @default("GUARDIAN") // GUARDIAN | AUTHORIZED | UNKNOWN
  method              String  @default("PIN") // QR | PIN | SEARCH | STAFF | PARENT_LINK
  dismissalMethod     String  @default("CARLINE") // CARLINE | WALKUP | BUS

  // Request-level rollup. Per-child truth lives on PickupRequestStudent.
  status String @default("REQUESTED") // REQUESTED | NEEDS_APPROVAL | IN_PROGRESS | COMPLETED | DENIED | CANCELLED | EXPIRED

  date        String // "YYYY-MM-DD"
  requestedAt DateTime  @default(now())
  resolvedAt  DateTime?
  deviceId    String?

  students  PickupRequestStudent[]
  approvals PickupApproval[]

  @@index([tenantId, date, status])
  @@index([householdId])
}

model PickupRequestStudent {
  id        String        @id @default(cuid())
  requestId String
  request   PickupRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  studentId String
  student   Student       @relation(fields: [studentId], references: [id])

  // The ladder, per child:
  // REQUESTED -> EN_ROUTE -> READY -> RELEASED   (+ NEEDS_APPROVAL branch, DENIED/CANCELLED terminals)
  status String @default("REQUESTED")

  enRouteAt  DateTime?
  readyAt    DateTime?
  releasedAt DateTime?

  teacherNotifiedAt DateTime?
  parentNotifiedAt  DateTime?

  // Only one live request per student per day — enforced in code at create
  // (an open item check), since the terminal rows must be allowed to accumulate.

  @@unique([requestId, studentId])
  @@index([studentId, status])
}

model PickupApproval {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  requestId String
  request   PickupRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  adultName  String
  adultPhone String?

  // Single-use link, bound to (adult, students, request). sha256 of the URL token.
  tokenHash String   @unique
  expiresAt DateTime

  status String @default("PENDING") // PENDING | APPROVED_ONCE | APPROVED_ALWAYS | DENIED | EXPIRED | OVERRIDDEN

  resolvedByGuardianId String?
  resolvedAt           DateTime?

  // Staff override path: supervisor + typed reason, both mandatory.
  overrideByStaffId String?
  overrideByName    String?
  overrideReason    String?

  createdAt DateTime @default(now())

  @@index([tenantId, status])
}

// ---------------------------------------------------------------------------
// Messaging + announcements
// ---------------------------------------------------------------------------

// Transactional outbox: rows are committed in the same transaction as the
// event that caused them. A worker drains QUEUED rows. Success = delivery
// receipt where the channel supports one, not an HTTP 200.
model MessageOutbox {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  channel String @default("SMS") // SMS | EMAIL
  toPhone String?
  toEmail String?
  body    String
  subject String?

  kind String // TEACHER_ALERT | PICKUP_READY | APPROVAL_REQUEST | APPROVAL_RESULT | GUARDIAN_ALERT | BALANCE | LATE | ANNOUNCEMENT | CANARY

  idempotencyKey String @unique

  status      String    @default("QUEUED") // QUEUED | SENDING | SENT | DELIVERED | FAILED
  attempts    Int       @default(0)
  lastError   String?
  providerId  String?
  sentAt      DateTime?
  deliveredAt DateTime?

  // What this message is about, for the audit trail.
  refType String?
  refId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([status, createdAt])
}

model Announcement {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  title   String
  body    String // full text, email + the /a/[id] page
  smsBody String? // short form + link; SMS never carries the whole announcement

  audienceKind  String  @default("ALL") // ALL | GRADE | BALANCE_DUE | STUDENTS
  audienceGrade String?
  audienceIds   Json? // student ids when STUDENTS

  channel String @default("SMS") // SMS | EMAIL | BOTH

  status       String    @default("DRAFT") // DRAFT | SCHEDULED | SENDING | SENT
  scheduledFor DateTime?
  sentAt       DateTime?

  createdById   String?
  createdByName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipients AnnouncementRecipient[]

  @@index([tenantId, status])
}

model AnnouncementRecipient {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  guardianId String
  channel    String
  status     String  @default("PENDING") // PENDING | SENT | DELIVERED | FAILED
  outboxId   String?

  @@unique([announcementId, guardianId, channel])
}

// ---------------------------------------------------------------------------
// Audit — append only, hash chained. There is no update or delete API path.
// ---------------------------------------------------------------------------

model AuditLog {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  seq BigInt @default(autoincrement())

  actorKind String // STAFF | GUARDIAN | DEVICE | SYSTEM
  actorId   String?
  actorName String

  action   String // CHECK_IN | ABSENT | PICKUP_REQUESTED | HELD | APPROVAL_SENT | APPROVED | DENIED | EN_ROUTE | READY | RELEASED | RELEASE_REVERSED | OVERRIDE | NOTIFY | ...
  entity   String
  entityId String?
  detail   String
  data     Json?

  prevHash String
  hash     String

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, entity, entityId])
}
